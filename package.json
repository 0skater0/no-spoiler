{
  "name": "no-spoiler",
  "version": "1.0.0",
  "private": true,
  "description": "Browser extension that hides spoilers on YouTube and Twitch.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:firefox": "node scripts/build.mjs firefox",
    "build:chrome": "node scripts/build.mjs chrome",
    "package": "node scripts/build.mjs && node scripts/package.mjs",
    "lint": "node scripts/build.mjs firefox && web-ext lint --source-dir dist/firefox --self-hosted=false",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "jsdom": "30.1.3",
    "vitest": "5.0.5",
    "web-ext": "10.8.0"
  }
}
