{
  "name": "no-spoiler",
  "version": "1.1.0",
  "private": true,
  "description": "Browser extension that hides spoilers on YouTube and Twitch.",
  "license": "MIT",
  "author": "0skater0",
  "homepage": "https://github.com/0skater0/no-spoiler#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0skater0/no-spoiler.git"
  },
  "bugs": {
    "url": "https://github.com/0skater0/no-spoiler/issues"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:firefox": "node scripts/build.mjs firefox",
    "build:chrome": "node scripts/build.mjs chrome",
    "package": "node scripts/build.mjs && node scripts/package.mjs",
    "lint": "node scripts/build.mjs firefox && web-ext lint --source-dir dist/firefox --self-hosted=false",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "jsdom": "30.1.3",
    "vitest": "5.0.5",
    "web-ext": "10.8.0"
  }
}
