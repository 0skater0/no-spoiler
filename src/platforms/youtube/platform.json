{
  "id": "youtube",
  "label": "YouTube",
  "matches": ["*://*.youtube.com/*"],
  "order": 10,
  "hostAccess": "optional",
  "contentScript": true,
  "options": [
    { "key": "hideVideoTime", "label": "Hide current time and duration in the player", "default": true, "group": "Player" },
    { "key": "hideProgressBar", "label": "Hide progress bar and chapter title", "default": true, "group": "Player" },
    { "key": "hideEndcards", "label": "Hide end screen and end cards", "default": true, "group": "Player" },
    { "key": "disableAutoplay", "label": "Turn off autoplay", "default": true, "group": "Player" },
    { "key": "skipButtons", "label": "Jump buttons in the player bar, next to play", "default": false, "group": "Jump buttons" },
    { "key": "skipButtonSteps", "label": "Jump sizes in the player bar", "type": "steps", "choices": [5, 10, 30, 60, 120, 300, 600, 900, 1800, 3600], "default": [300, 600], "dependsOn": "skipButtons", "group": "Jump buttons" },
    { "key": "overlayControls", "label": "Jump buttons in the middle of the video (on hover)", "default": false, "group": "Jump buttons" },
    { "key": "overlaySteps", "label": "Jump sizes in the middle", "type": "steps", "choices": [5, 10, 30, 60, 120, 300, 600, 900, 1800, 3600], "default": [60, 300, 600], "dependsOn": "overlayControls", "group": "Jump buttons" },
    { "key": "hideComments", "label": "Hide comments", "default": true, "group": "Watch page" },
    { "key": "hideDescription", "label": "Hide description and chapter list", "default": true, "group": "Watch page" },
    { "key": "hideRecommendations", "label": "Hide recommendations next to the video", "default": true, "group": "Watch page" },
    { "key": "hideChat", "label": "Hide live chat and chat replay", "default": true, "group": "Watch page" },
    { "key": "hideThumbnailDurations", "label": "Hide durations on thumbnails", "default": true, "group": "Thumbnails" },
    { "key": "hideWatchProgress", "label": "Hide watch progress bars on thumbnails", "default": true, "group": "Thumbnails" },
    { "key": "maskTitles", "label": "Hide video titles (page, player, thumbnails, browser tab)", "default": false, "group": "Titles" },
    { "key": "hideTooltips", "label": "Hide title tooltips", "default": false, "group": "Titles" }
  ]
}
