{
  "id": "kick",
  "label": "Kick",
  "matches": ["https://kick.com/*", "https://*.kick.com/*"],
  "order": 30,
  "hostAccess": "optional",
  "contentScript": true,
  "options": [
    { "key": "hideCurrentTime", "label": "Hide current time in the player", "default": true, "group": "Player" },
    { "key": "hideDuration", "label": "Hide duration in the player", "default": true, "group": "Player" },
    { "key": "hideSeekbar", "label": "Hide seek bar", "default": true, "group": "Player" },
    { "key": "hideSeekbarPreview", "label": "Hide seek bar hover preview", "default": true, "group": "Player" },
    { "key": "skipButtons", "label": "Jump buttons in the player bar on videos, next to play", "default": false, "group": "Jump buttons" },
    { "key": "skipButtonSteps", "label": "Jump sizes in the player bar", "type": "steps", "choices": [5, 10, 30, 60, 120, 300, 600, 900, 1800, 3600], "default": [300, 600], "dependsOn": "skipButtons", "group": "Jump buttons" },
    { "key": "overlayControls", "label": "Jump buttons in the middle of videos (on hover)", "default": false, "group": "Jump buttons" },
    { "key": "overlaySteps", "label": "Jump sizes in the middle", "type": "steps", "choices": [5, 10, 30, 60, 120, 300, 600, 900, 1800, 3600], "default": [60, 300, 600], "dependsOn": "overlayControls", "group": "Jump buttons" },
    { "key": "hideVodChatReplay", "label": "Collapse chat replay on videos", "default": true, "group": "Chat" },
    { "key": "blurThumbnails", "label": "Blur video and clip thumbnails", "default": true, "group": "Cards" },
    { "key": "blurLiveThumbnails", "label": "Blur live stream thumbnails", "default": false, "group": "Cards" },
    { "key": "hideCardDurations", "label": "Hide video and clip lengths", "default": true, "group": "Cards" },
    { "key": "disableCardHoverPreview", "label": "Disable clip previews on hover", "default": true, "group": "Cards" },
    { "key": "hideCardCategory", "label": "Hide category", "default": false, "group": "Cards" },
    { "key": "hideCardTags", "label": "Hide tags", "default": false, "group": "Cards" },
    { "key": "hideCardAvatar", "label": "Hide streamer avatar", "default": false, "group": "Cards" },
    { "key": "hideCardChannelName", "label": "Hide streamer name", "default": false, "group": "Cards" },
    { "key": "maskTitles", "label": "Hide titles of streams, videos and clips", "default": false, "group": "Titles" },
    { "key": "hideTooltips", "label": "Hide the full title on hover", "default": false, "group": "Titles" },
    { "key": "hideCarousel", "label": "Hide featured carousel on the home page", "default": false, "group": "Home page and sidebar" },
    { "key": "hideSidebarRecommended", "label": "Hide recommended channels in the sidebar", "default": false, "group": "Home page and sidebar" },
    { "key": "hideLiveUptime", "label": "Hide stream uptime in the player", "default": true, "group": "Live" },
    { "key": "liveFromStart", "label": "Start live streams from the beginning", "default": false, "group": "Live" }
  ]
}
