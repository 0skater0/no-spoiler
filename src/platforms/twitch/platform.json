{
  "id": "twitch",
  "label": "Twitch",
  "matches": ["https://*.twitch.tv/*"],
  "order": 20,
  "hostAccess": "optional",
  "contentScript": true,
  "options": [
    { "key": "hidePlayerTime", "label": "Hide current time and duration in the player", "default": true, "group": "Player" },
    { "key": "hideSeekbarProgress", "label": "Hide progress in the seek bar", "default": true, "group": "Player" },
    { "key": "hideSeekbarPreview", "label": "Hide seek bar hover preview", "default": true, "group": "Player" },
    { "key": "hideEndRecommendations", "label": "Hide recommendations at the end of a video", "default": true, "group": "Player" },
    { "key": "skipButtons", "label": "Show skip buttons next to play on videos (-10, -5, +5, +10 min)", "default": false, "group": "Player" },
    { "key": "overlayControls", "label": "Show seek controls in the middle of videos on hover", "default": false, "group": "Player" },
    { "key": "hideVodChatReplay", "label": "Hide chat replay on videos", "default": true, "group": "Chat" },
    { "key": "hideLiveChat", "label": "Hide chat on live streams", "default": false, "group": "Chat" },
    { "key": "blurThumbnails", "label": "Blur video and clip thumbnails", "default": true, "group": "Cards" },
    { "key": "blurLiveThumbnails", "label": "Blur live stream thumbnails", "default": false, "group": "Cards" },
    { "key": "hideCardDurations", "label": "Hide video and clip lengths", "default": true, "group": "Cards" },
    { "key": "hideWatchProgress", "label": "Hide watch progress bars on videos", "default": true, "group": "Cards" },
    { "key": "disableCardHoverPreview", "label": "Disable video previews on hover", "default": true, "group": "Cards" },
    { "key": "hideCardCategory", "label": "Hide category", "default": false, "group": "Cards" },
    { "key": "hideCardTags", "label": "Hide tags", "default": false, "group": "Cards" },
    { "key": "hideCardAvatar", "label": "Hide streamer avatar", "default": false, "group": "Cards" },
    { "key": "hideCardChannelName", "label": "Hide streamer name", "default": false, "group": "Cards" },
    { "key": "maskTitles", "label": "Hide titles of streams, videos and clips", "default": false, "group": "Titles" },
    { "key": "hideTooltips", "label": "Hide title tooltips", "default": false, "group": "Titles" },
    { "key": "hideCarousel", "label": "Hide featured carousel on the home page", "default": false, "group": "Home page and sidebar" },
    { "key": "hideSidebarRecommended", "label": "Hide recommended channels in the sidebar", "default": false, "group": "Home page and sidebar" },
    { "key": "hideSidebarCategories", "label": "Hide recommended categories in the sidebar", "default": false, "group": "Home page and sidebar" },
    { "key": "hideLiveUptime", "label": "Hide stream uptime", "default": true, "group": "Live" }
  ]
}
