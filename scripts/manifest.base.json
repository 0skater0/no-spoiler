{
  "manifest_version": 3,
  "name": "No Spoilers",
  "homepage_url": "https://github.com/0skater0/no-spoiler",
  "icons": {
    "16": "icons/on-16.png",
    "32": "icons/on-32.png",
    "48": "icons/on-48.png",
    "128": "icons/on-128.png"
  },
  "action": {
    "default_title": "No Spoilers",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/on-16.png",
      "32": "icons/on-32.png",
      "48": "icons/on-48.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-addon": {
      "suggested_key": {
        "default": "Ctrl+Alt+U",
        "mac": "Command+Alt+U"
      },
      "description": "Switch No Spoilers on or off"
    }
  },
  "permissions": ["storage", "scripting", "activeTab"]
}
